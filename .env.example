# Copy to .env (gitignored) and fill in. Never commit .env.

# Meta Model API key (Standard mode)
MODEL_API_KEY=

# Meta endpoints
META_API_BASE=https://api.meta.ai/v1

# Local Glimmer server (llama-server)
SE_LOCAL_LLM_URL=http://127.0.0.1:8001/v1
SE_LOCAL_LLM_MODEL=glimmer

# Spend controls (USD). Runs refuse to start if their projected cost would exceed these.
SE_SPEND_CAP_TOTAL=150
SE_SPEND_CAP_PER_RUN=10

# Where large data lives (outside the repo is fine)
SE_DATA_DIR=..\data
