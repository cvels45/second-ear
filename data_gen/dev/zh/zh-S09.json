 "lines": {
  "1": {
   "q": "今天我们会逐行检查您的声明。可以吗？",
   "a": "可以，没问题。"
  },
  "2": {
   "q": "第三段说您被拘留了两天。对吗？",
   "a": "不对，是四天。在派出所两天，在另一个地方两天。"
  },
  "3": {
   "q": "第五段说您哥哥是证人。对吗？",
   "a": "对。我哥哥小东从窗户里看到了一切。"
  },
  "4": {
   "q": "您写了您在二〇一九年申请过签证。是什么签证？",
   "a": "旅游签证。面签的时候被拒了。"
  },
  "5": {
   "q": "您有没有在其他国家申请过庇护？",
   "a": "没有，从来没有。我只是在厄瓜多尔过境了三天。"
  },
  "6": {
   "q": "声明里说威胁是从二〇二〇年开始的。具体是什么时候开始的？",
   "a": [
    "第一次威胁是二〇一九年十二月，是打电话来的。",
    "当面威胁是从二〇二〇年二月开始的。"
   ]
  },
  "7": {
   "q": "医生的信是谁写的？",
   "a": "成都诊所的刘医生。袭击以后他给我治疗了肋骨。"
  },
  "8": {
   "q": "您确定袭击是在六月吗？",
   "a": "我觉得是六月，但也可能是七月初。就在我生日后不久。"
  },
  "9": {
   "q": "您在派出所有没有签过什么东西？",
   "a": "签过，他们逼我签了一份笔录，但是不让我看。"
  },
  "10": {
   "q": "声明里有没有您想修改的地方？",
   "a": "只有我被拘留的天数，还有威胁是从十二月开始的。"
  }
 },
